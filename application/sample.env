# Copy this file to ../.env (project root) and fill in the values.
# Do NOT commit .env — it is gitignored.

# ── LLM ─────────────────────────────────────────────────
# Required. Used for chat responses, moderation, and source verification.
OPENAI_API_KEY=sk-...

# ── PostgreSQL (Railway) ─────────────────────────────────
# Required for RAG (pgvector) and message logging.
# Railway auto-injects DATABASE_URL. For local dev, use one of these:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Or individual DB_* vars:
# DB_HOST=localhost
# DB_USER=waterbot_admin
# DB_PASSWORD=localpass
# DB_NAME=waterbot_db
# DB_PORT=5432

# ── Transcript storage (local filesystem) ────────────────
# Optional. If omitted, transcripts are returned inline.
# TRANSCRIPT_STORAGE_PATH=/app/transcripts

# ── Session / Admin Auth ─────────────────────────────────
# Strongly recommended. Signs user session IDs and the admin login session.
# If omitted, a random key is generated each restart (sessions won't survive restarts).
# Must be the same on every instance if more than one runs.
# SESSION_SECRET=
#
# Admin login (/admin/login, /messages, /download-messages). Admin access is
# DISABLED unless both are set. Generate the hash with:
#   python scripts/hash_admin_password.py
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=

# ── Safety screening (every Blue message and follow-up button) ──
# Classifier model and options. If the classifier or the moderation check fails,
# messages are refused (fail closed).
# SAFETY_MODEL=gpt-6-luna
# SAFETY_REASONING_EFFORT=none
# SAFETY_TIMEOUT_SECONDS=15
# MODERATION_MODEL=omni-moderation-latest

# ── Limits ───────────────────────────────────────────────
# Requests that reach the AI service, per 5 minutes (per session / per IP), and per minute overall.
# RATE_LIMIT_PER_SESSION=30
# RATE_LIMIT_PER_IP=120
# RATE_LIMIT_GLOBAL_PER_MINUTE=600
# Number of proxies in front of the app that append to X-Forwarded-For (Railway: 1).
# TRUSTED_PROXY_HOPS=1
# MAX_QUERY_CHARS=2000
# MAX_FOLLOW_UPS_PER_QUESTION=4
# MAX_FOLLOW_UPS_PER_SESSION=40
# Largest request body accepted (bytes); bigger ones get 413 before being read.
# MAX_REQUEST_BYTES=1000000
# Worker threads for OpenAI/database calls. Python's default (~20) queued visitors
# under load; each thread mostly waits on the network.
# AI_WORKER_THREADS=100
# BLUE_HISTORY_TURNS=10
# BLUE_LLM_TIMEOUT_SECONDS=30
# BLUE_LLM_MAX_RETRIES=1

# ── Content-Security-Policy ──────────────────────────────
# enforce (default) | report-only | off
# CSP_MODE=enforce
# Sites allowed to show the chat in a frame (default: only this site).
# CSP_FRAME_ANCESTORS='self'

# ── Cross-site access / API docs ─────────────────────────
# Other sites allowed to call the API (comma-separated). Default: the Railway
# production URL only. Browser POSTs from any other site are refused (403).
# For local development with a separate frontend, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# /docs, /redoc and /openapi.json are off unless this is true (local only).
# ENABLE_API_DOCS=false

# ── Sources Verifier ─────────────────────────────────────
# Optional. Tune the source-verification LLM call.
# SOURCES_VERIFIER_MODEL=gpt-4o-mini
# SOURCES_VERIFIER_TIMEOUT=5.0
# SOURCES_VERIFIER_MAX_TOKENS=64
